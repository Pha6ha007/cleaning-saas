# =============================================================================
# Proof Platform — Backend Production Environment Variables
# =============================================================================
# Copy to .env on your production server / set in hosting platform
# NEVER commit real values to git!
# =============================================================================

# --- Django Core ---
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.proofplatform.com,app.proofplatform.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/proofplatform

# --- CORS ---
CORS_ORIGINS=https://app.proofplatform.com,https://staging.proofplatform.com

# --- File Storage (S3-compatible) ---
# For DigitalOcean Spaces:
AWS_STORAGE_BUCKET_NAME=proofplatform-media
AWS_S3_REGION_NAME=fra1
AWS_ACCESS_KEY_ID=your-spaces-key
AWS_SECRET_ACCESS_KEY=your-spaces-secret
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
# Optional: CDN URL for faster media delivery
# MEDIA_URL=https://proofplatform-media.fra1.cdn.digitaloceanspaces.com/

# For AWS S3 (no endpoint URL needed):
# AWS_STORAGE_BUCKET_NAME=proofplatform-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret

# For Cloudflare R2:
# AWS_STORAGE_BUCKET_NAME=proofplatform-media
# AWS_ACCESS_KEY_ID=your-r2-key
# AWS_SECRET_ACCESS_KEY=your-r2-secret
# AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# --- Email (SMTP) ---
# Option 1: SendGrid (recommended)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key

# Option 2: Mailgun
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@mg.proofplatform.com
# EMAIL_HOST_PASSWORD=your-mailgun-password

# Option 3: Gmail (for low volume / testing)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=reports.cleanproof@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

DEFAULT_FROM_EMAIL=Proof Platform <noreply@proofplatform.com>

# --- Paddle Billing ---
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your-webhook-secret
PADDLE_ENVIRONMENT=production
PADDLE_PRICE_ID_STANDARD=pri_your-standard-price
PADDLE_PRICE_ID_PRO=pri_your-pro-price

# --- Sentry Error Monitoring ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
CSRF_TRUSTED_ORIGINS=https://app.proofplatform.com,https://api.proofplatform.com
